            document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (i18n[lang][key]) el.innerText = i18n[lang][key];
            });
            document.getElementById('appReplyCommandInput').placeholder = t('cmdPlaceholder');
            document.getElementById('btnToggleTheme').innerText = state.isDarkMode ? t('themeToLight') : t('themeToDark');
            updateCurrentUI(state.amperes);
            updateGasState(state.gasPPM, false);
        }

        function applyTheme(dark) {
            state.isDarkMode = dark;
            localStorage.setItem('sgr_theme', dark ? 'dark' : 'light');
            document.body.classList.toggle('light-mode', !dark);
            document.getElementById('btnToggleTheme').innerText = dark ? t('themeToLight') : t('themeToDark');
            updateChartTheme();
        }

        function updateCurrentUI(amps) {
            state.amperes = parseFloat(amps);
            document.getElementById('valCurrentDisplay').innerText = state.amperes.toFixed(1);
            document.getElementById('lblSliderCurrent').innerText = `${state.amperes.toFixed(1)} A`;
            const respTime = Math.max(0.4, (2.5 - (state.amperes * 0.18))).toFixed(2);
            document.getElementById('valResponseTime').innerText = `< ${respTime}`;

            const textCurrentImpact = document.getElementById('textCurrentImpact');
            if (state.amperes < 3.0) {
                textCurrentImpact.className = 'text-[10px] text-center text-futuristic-warning bg-futuristic-warning/10 py-1 rounded-lg border border-futuristic-warning/20 font-bold';
                textCurrentImpact.innerText = t('currSlow');
            } else if (state.amperes > 8.5) {
                textCurrentImpact.className = 'text-[10px] text-center text-futuristic-danger bg-futuristic-danger/10 py-1 rounded-lg border border-futuristic-danger/20 font-bold';
                textCurrentImpact.innerText = t('currOverload');
            } else {
                textCurrentImpact.className = 'text-[10px] text-center text-emerald-400 bg-emerald-500/10 py-1 rounded-lg border border-emerald-500/20 font-bold';
                textCurrentImpact.innerText = t('currFast');
            }
        }

        function syncAudioButtonUI() {
            const icon = document.getElementById('iconMuteAudio');
            icon.className = state.isAudioMuted
                ? 'fa-solid fa-volume-xmark text-futuristic-danger text-base'
                : 'fa-solid fa-volume-high text-futuristic-cyan text-base';
        }

        function syncProviderFields() {
            const p = document.getElementById('selectMsgProvider').value;
            document.getElementById('cfgNtfy').classList.toggle('hidden', p !== 'ntfy');
            document.getElementById('cfgTelegram').classList.toggle('hidden', p !== 'telegram');
            document.getElementById('cfgWebhook').classList.toggle('hidden', p !== 'webhook');

            const badge = document.getElementById('badgeApiStatus');
            const channelTxt = document.getElementById('txtActiveChannel');
            if (p === 'ntfy' && state.ntfyTopic) {
                badge.innerText = 'ntfy.sh Ready';
                badge.className = 'text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 font-mono';
                channelTxt.innerText = `ntfy.sh/${state.ntfyTopic}`;
            } else if (p === 'telegram' && state.tgToken && state.tgChatId) {
                badge.innerText = 'Telegram Ready';
                badge.className = 'text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 font-mono';
                channelTxt.innerText = `Telegram Bot Connected`;
            } else if (p === 'webhook' && state.webhookUrl) {
                badge.innerText = 'Webhook Ready';
                badge.className = 'text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 font-mono';
                channelTxt.innerText = `Webhook Active`;
            } else {
                badge.innerText = 'SMS / Local';
                badge.className = 'text-[10px] px-2 py-0.5 rounded-full bg-slate-700 text-slate-300 font-mono';
                channelTxt.innerText = 'Real SMS / WhatsApp Ready';
            }
        }

        function switchToScreen(screenNum) {
            const screen1 = document.getElementById('screen1');
            const screen2 = document.getElementById('screen2');
            const nav1 = document.getElementById('navBtnScreen1');
            const nav2 = document.getElementById('navBtnScreen2');
            const dot1 = document.getElementById('dotBtnScreen1');
            const dot2 = document.getElementById('dotBtnScreen2');

            if (screenNum === 1) {
                screen1.classList.remove('hidden');
                screen2.classList.add('hidden');
                screen2.classList.remove('flex');
                nav1.className = 'px-4 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-2 bg-futuristic-accent text-slate-950 shadow-md';
                nav2.className = 'px-4 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-2 opacity-75 hover:opacity-100';
                dot1.className = 'h-3 rounded-full transition-all duration-300 dot-active w-7';
                dot2.className = 'w-3 h-3 rounded-full bg-slate-600 hover:bg-slate-400 transition-all duration-300';
            } else {
                screen1.classList.add('hidden');
                screen2.classList.remove('hidden');
                screen2.classList.add('flex');
                nav2.className = 'px-4 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-2 bg-futuristic-accent text-slate-950 shadow-md';
                nav1.className = 'px-4 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-2 opacity-75 hover:opacity-100';
                dot2.className = 'h-3 rounded-full transition-all duration-300 dot-active w-7';
                dot1.className = 'w-3 h-3 rounded-full bg-slate-600 hover:bg-slate-400 transition-all duration-300';
            }
        }

        function saveSettingsFromUI() {
            state.provider = document.getElementById('selectMsgProvider').value;
            state.ntfyTopic = document.getElementById('inputNtfyTopic').value.trim();
            state.tgToken = document.getElementById('inputTgToken').value.trim();
            state.tgChatId = document.getElementById('inputTgChatId').value.trim();
            state.webhookUrl = document.getElementById('inputWebhookUrl').value.trim();

            localStorage.setItem('sgr_provider', state.provider);
            localStorage.setItem('sgr_ntfyTopic', state.ntfyTopic);
            localStorage.setItem('sgr_tgToken', state.tgToken);
            localStorage.setItem('sgr_tgChatId', state.tgChatId);
            localStorage.setItem('sgr_webhookUrl', state.webhookUrl);
            syncProviderFields();
        }

        // Event Listeners
        document.getElementById('navBtnScreen1').addEventListener('click', () => switchToScreen(1));
        document.getElementById('navBtnScreen2').addEventListener('click', () => switchToScreen(2));
        document.getElementById('dotBtnScreen1').addEventListener('click', () => switchToScreen(1));
        document.getElementById('dotBtnScreen2').addEventListener('click', () => switchToScreen(2));

        document.getElementById('btnOpenSettings').addEventListener('click', () => document.getElementById('settingsModal').classList.remove('hidden'));
        document.getElementById('btnCloseSettings').addEventListener('click', () => document.getElementById('settingsModal').classList.add('hidden'));
        document.getElementById('btnSaveSettings').addEventListener('click', () => {
            saveSettingsFromUI();
            document.getElementById('settingsModal').classList.add('hidden');
            showToast(state.lang === 'ar' ? '✓ تم حفظ الإعدادات' : '✓ Settings saved', 'success');
        });

        document.getElementById('selectMsgProvider').addEventListener('change', saveSettingsFromUI);
        document.getElementById('btnTestRealMsg').addEventListener('click', async () => {
            saveSettingsFromUI();
            const testMsg = buildAlertMessage('🔔 TEST ALERT - Smart Gas Rescue System');
            await sendRealBackgroundAlert(testMsg, true);
        });

        document.getElementById('btnRequestBrowserNotif').addEventListener('click', async () => {
            if (!('Notification' in window)) {
                showToast('Browser notifications not supported.', 'warning');
                return;
            }
            const perm = await Notification.requestPermission();
            showToast(`Notification permission: ${perm}`, perm === 'granted' ? 'success' : 'warning');
        });

        document.getElementById('btnToggleTheme').addEventListener('click', () => applyTheme(!state.isDarkMode));
        document.getElementById('selectLang').addEventListener('change', (e) => applyLanguage(e.target.value));

        document.getElementById('btnMuteAudio').addEventListener('click', () => {
            state.isAudioMuted = !state.isAudioMuted;
            syncAudioButtonUI();
            syncBuzzerAudio();
        });

        // Interactive Actuator Cards
        document.getElementById('cardFan').addEventListener('click', () => {
            state.isFanOverride = !state.isFanOverride;
            updateActuatorsUI();
            logSystemMessage(`Manual Toggle: Exhaust Fan ${state.isFanOverride ? 'ON' : 'OFF'}`, 'accent');
        });
        document.getElementById('cardPower').addEventListener('click', () => {
            state.isPowerCutOverride = !state.isPowerCutOverride;
            updateActuatorsUI();
            logSystemMessage(`Manual Toggle: Main Power ${state.isPowerCutOverride ? 'CUT OFF' : 'ON'}`, 'danger');
        });
        document.getElementById('cardBuzzer').addEventListener('click', () => {
            state.isBuzzerOverride = !state.isBuzzerOverride;
            if (state.isBuzzerOverride) state.isAudioMuted = false;
            syncAudioButtonUI();
            updateActuatorsUI();
            logSystemMessage(`Manual Toggle: Buzzer ${state.isBuzzerOverride ? 'ON' : 'OFF'}`, 'warning');
        });
        document.getElementById('cardSMSAlert').addEventListener('click', () => {
            const msg = buildAlertMessage('🚨 Manual Alert Triggered from Device Panel');
            appendAppMessage('Manual Alert', msg);
            sendRealBackgroundAlert(msg, true);
        });

        // SMS Trigger Radio Modes
        document.querySelectorAll('input[name="smsSendMode"]').forEach(radio => {
            radio.addEventListener('change', (e) => {
                const btnManual = document.getElementById('btnManualTriggerSMS');
                const btnNative = document.getElementById('btnOpenNativeSms');
                if (e.target.value === 'manual') {
                    btnManual.classList.remove('hidden');
                    btnNative.classList.remove('col-span-2');
                } else {
                    btnManual.classList.add('hidden');
                    btnNative.classList.add('col-span-2');
                }
            });
        });

        document.getElementById('btnManualTriggerSMS').addEventListener('click', () => {
            const msg = buildAlertMessage(`🚨 Manual Emergency Alert (${state.gasPPM} PPM)`);
            appendAppMessage('Manual SMS/Push', msg);
            sendRealBackgroundAlert(msg, true);
        });

        // Sliders & Presets
        document.getElementById('inputGasSlider').addEventListener('input', (e) => updateGasState(e.target.value, true));
        document.getElementById('inputCurrentSlider').addEventListener('input', (e) => updateCurrentUI(e.target.value));
        document.getElementById('btnPresetNormal').addEventListener('click', () => {
            document.getElementById('chkContinuousLeak').checked = false;
            state.isFanOverride = false;
            state.isPowerCutOverride = false;
            state.isBuzzerOverride = false;
            updateGasState(120, true);
        });
        document.getElementById('btnPresetDanger').addEventListener('click', () => {
            updateGasState(780, true);
        });

        document.getElementById('btnClearLogs').addEventListener('click', () => {
            terminalLogBox.innerHTML = '';
        });

        // Phone Save & Commands (Screen 2)
        document.getElementById('btnSaveAppPhone').addEventListener('click', () => {
            const phone = document.getElementById('appPhoneInput').value.trim();
            if (phone) {
                state.phone = phone;
                localStorage.setItem('sgr_phone', phone);
                document.getElementById('appDisplayPhoneNum').innerText = phone;
                updateNativeSmsLinks();
                const savedMsg = document.getElementById('msgPhoneSaved');
                savedMsg.classList.remove('hidden');
                logSystemMessage(`Emergency contact updated to: ${phone}`, 'accent');
                setTimeout(() => savedMsg.classList.add('hidden'), 3000);
            }
        });

        document.getElementById('btnSendAppCommand').addEventListener('click', () => {
            const input = document.getElementById('appReplyCommandInput');
            const txt = input.value.trim();
            if (txt) {
                processRemoteCommand(txt);
                input.value = '';
            }
        });

        document.getElementById('appReplyCommandInput').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') document.getElementById('btnSendAppCommand').click();
        });

        document.getElementById('btnQuickFanCmd').addEventListener('click', () => processRemoteCommand(state.lang === 'ar' ? 'تشغيل الشفاط' : 'toggle fan'));
        document.getElementById('btnQuickPowerCmd').addEventListener('click', () => processRemoteCommand(state.lang === 'ar' ? 'فصل الكهرباء' : 'toggle power'));
        document.getElementById('btnQuickStatusCmd').addEventListener('click', () => processRemoteCommand(state.lang === 'ar' ? 'فحص الحالة' : 'status'));
        document.getElementById('btnQuickResetCmd').addEventListener('click', () => processRemoteCommand(state.lang === 'ar' ? 'تصفير' : 'reset'));

        // Star Rating Persistence
        function renderStars(count) {
            document.querySelectorAll('#starRatingBox [data-star]').forEach(el => {
                const s = parseInt(el.getAttribute('data-star'));
                el.classList.toggle('text-futuristic-warning', s <= count);
            });
        }
        document.querySelectorAll('#starRatingBox [data-star]').forEach(el => {
            el.addEventListener('click', () => {
                state.rating = parseInt(el.getAttribute('data-star'));
                localStorage.setItem('sgr_rating', state.rating);
                renderStars(state.rating);
                showToast(`Thank you for rating ${state.rating}/5!`, 'success');
            });
        });

        // Initialization
        window.onload = function () {
            document.getElementById('selectLang').value = state.lang;
            document.getElementById('appPhoneInput').value = state.phone;
            document.getElementById('appDisplayPhoneNum').innerText = state.phone;
            document.getElementById('selectMsgProvider').value = state.provider;
            document.getElementById('inputNtfyTopic').value = state.ntfyTopic;
            document.getElementById('inputTgToken').value = state.tgToken;
            document.getElementById('inputTgChatId').value = state.tgChatId;
            document.getElementById('inputWebhookUrl').value = state.webhookUrl;

            initChart();
            applyTheme(state.isDarkMode);
            applyLanguage(state.lang);
            syncProviderFields();
            syncAudioButtonUI();
            renderStars(state.rating);
            updateNativeSmsLinks();
        };
    </script>
</body>
</html>