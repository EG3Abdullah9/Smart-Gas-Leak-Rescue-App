                    appendAppMessage('System (SMS Reply)', msg);
                    logSystemMessage(`Remote Command: POWER ${state.isPowerCutOverride ? 'CUT' : 'ON'}`, 'danger');
                } else if (lower.includes('حالة') || lower.includes('فحص') || lower.includes('status')) {
                    const report = buildAlertMessage('📊 Live System Status Report');
                    appendAppMessage('System (SMS Reply)', report);
                    logSystemMessage('Remote Command: STATUS REPORT SENT', 'accent');
                } else if (lower.includes('تشغيل') || lower.includes('إعادة') || lower.includes('تصفير') || lower.includes('reset') || lower.includes('start')) {
                    state.isEmergency = false;
                    state.isFanOverride = false;
                    state.isPowerCutOverride = false;
                    state.isBuzzerOverride = false;
