            const colors = {
                success: 'bg-emerald-950/90 border-emerald-400 text-emerald-200',
                danger: 'bg-rose-950/90 border-futuristic-danger text-rose-200',
                warning: 'bg-amber-950/90 border-futuristic-warning text-amber-200',
                info: 'bg-slate-900/95 border-futuristic-cyan text-cyan-100'
            };
            el.className = `pointer-events-auto px-3.5 py-2.5 rounded-xl border text-xs font-bold shadow-xl backdrop-blur-md transition-all ${colors[type] || colors.info}`;
