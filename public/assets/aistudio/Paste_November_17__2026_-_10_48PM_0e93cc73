                return d.toTimeString().split(' ')[0];
            });

            chartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels,
                    datasets: [{
                        label: 'Gas Concentration (PPM)',
                        data: Array(10).fill(120),
                        borderColor: '#00F5D4',
                        borderWidth: 2.5,
                        backgroundColor: 'rgba(0, 245, 212, 0.1)',
                        fill: true,
                        tension: 0.35,
                        pointRadius: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: { duration: 300 },
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { color: gridColor }, ticks: { color: tickColor, font: { size: 9 }, maxTicksLimit: 6 } },
                        y: { min: 0, max: 1000, grid: { color: gridColor }, ticks: { color: tickColor, font: { size: 10 } } }
                    }
