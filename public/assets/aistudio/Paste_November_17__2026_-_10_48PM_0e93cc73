<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smart Gas Leak Rescue System - Master Simulator</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Cairo -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800;900&display=swap" rel="stylesheet">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Cairo', 'sans-serif'],
                    },
                    colors: {
                        futuristic: {
                            bg: '#040914',
                            panel: '#0B132B',
                            card: '#1C2541',
                            accent: '#00F5D4',
                            neon: '#7B2CBF',
                            danger: '#FF0054',
                            warning: '#FFBD00',
                            cyan: '#00BBF9'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background: radial-gradient(circle at top center, #0B132B 0%, #040914 100%);
            color: #F8FAFC;
            min-height: 100vh;
            overflow-y: auto;
            transition: background 0.3s, color 0.3s;
        }

        body.light-mode {
            background: radial-gradient(circle at top center, #E2E8F0 0%, #F8FAFC 100%);
            color: #0F172A;
        }

        .glass-card {
            background: rgba(28, 37, 65, 0.45);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 1rem;
            transition: background 0.3s, border 0.3s, box-shadow 0.3s;
        }

        body.light-mode .glass-card {
            background: rgba(255, 255, 255, 0.9);
            border: 1px solid rgba(15, 23, 42, 0.1);
            box-shadow: 0 10px 25px rgba(15, 23, 42, 0.06);
        }

        body.light-mode .sub-panel {
            background: rgba(15, 23, 42, 0.05) !important;
            border-color: rgba(15, 23, 42, 0.1) !important;
        }

        body.light-mode .modal-card {
            background: #FFFFFF;
            color: #0F172A;
        }

        .glow-accent {
            box-shadow: 0 0 25px rgba(0, 245, 212, 0.3);
        }
        .glow-danger {
            box-shadow: 0 0 30px rgba(255, 0, 84, 0.5);
        }

        @keyframes spinSlow {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        .animate-fan-fast {
            animation: spinSlow 0.35s linear infinite;
        }

        .dot-active {
            width: 1.75rem;
            background-color: #00F5D4;
            box-shadow: 0 0 12px #00F5D4;
        }

        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(0,0,0,0.1);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(148,163,184,0.35);
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #00F5D4;
        }
    </style>
</head>
<body class="p-3 md:p-6 flex flex-col justify-between gap-4">

    <!-- TOAST NOTIFICATIONS CONTAINER -->
    <div id="toastContainer" class="fixed top-20 left-4 z-[60] flex flex-col gap-2 max-w-xs pointer-events-none"></div>

    <!-- TOP BAR NAVIGATION & HEADER -->
    <header class="glass-card p-4 flex flex-wrap items-center justify-between gap-3 sticky top-2 z-50">
        <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-futuristic-accent to-futuristic-cyan flex items-center justify-center text-slate-950 font-black text-xl shadow-lg glow-accent">
                <i class="fa-solid fa-shield-halved"></i>
            </div>
            <div>
                <h1 class="text-lg md:text-xl font-extrabold flex items-center gap-2">
                    <span id="txtHeaderTitle" data-i18n="headerTitle">نظام الإنقاذ والتحكم الذكي في تسرب الغاز</span>
                    <span class="text-[10px] bg-futuristic-accent/20 border border-futuristic-accent/50 text-futuristic-accent px-2 py-0.5 rounded-full font-mono">v3.5 Live</span>
                </h1>
                <p class="text-xs opacity-75" data-i18n="headerSubtitle">منصة التحكم الصناعي والمحمول - إرسال تنبيهات حقيقية</p>
            </div>
        </div>

        <!-- Top Screen Switching Pills -->
        <div class="flex items-center gap-2 bg-black/20 sub-panel p-1.5 rounded-2xl border border-white/10">
            <button id="navBtnScreen1" class="px-4 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-2 bg-futuristic-accent text-slate-950 shadow-md">
                <i class="fa-solid fa-microchip"></i> <span data-i18n="navDevice">محاكي الجهاز المباشر</span>
            </button>
            <button id="navBtnScreen2" class="px-4 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-2 opacity-75 hover:opacity-100">
                <i class="fa-solid fa-mobile-screen"></i> <span data-i18n="navApp">تطبيق الهاتف (v1.0)</span>
            </button>
        </div>

        <!-- Quick Settings & Status Tools -->
        <div class="flex items-center gap-2 flex-wrap">
            <div id="topStatusBadge" class="flex items-center gap-2 bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 px-3 py-1.5 rounded-xl text-xs font-bold">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
                <span id="topStatusText">حالة الحساسات آمنة</span>
            </div>
            <button id="btnMuteAudio" title="Mute / Unmute Buzzer" class="w-10 h-10 rounded-xl glass-card flex items-center justify-center hover:scale-105 transition border border-white/10">
                <i id="iconMuteAudio" class="fa-solid fa-volume-high text-futuristic-cyan text-base"></i>
            </button>
            <button id="btnArduinoSerial" title="Connect Real Arduino via USB" class="px-3 h-10 rounded-xl glass-card flex items-center gap-1.5 hover:scale-105 transition border border-white/10 text-xs font-bold">
                <i class="fa-brands fa-usb text-futuristic-warning"></i>
                <span class="hidden sm:inline" data-i18n="btnUsb">USB أردوينو</span>
            </button>
            <button id="btnOpenSettings" class="w-10 h-10 rounded-xl glass-card flex items-center justify-center hover:scale-105 transition border border-white/10">
                <i class="fa-solid fa-gear text-futuristic-accent text-lg"></i>
            </button>
        </div>
    </header>

    <!-- SETTINGS MODAL / DRAWER -->
    <div id="settingsModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-50 hidden flex items-center justify-center p-4 overflow-y-auto">
        <div class="glass-card modal-card max-w-lg w-full p-6 flex flex-col gap-4 relative shadow-2xl border border-white/20 my-auto">
            <div class="flex justify-between items-center border-b border-white/10 pb-3">
                <h3 class="font-bold text-lg flex items-center gap-2 text-futuristic-accent">
                    <i class="fa-solid fa-sliders"></i> <span data-i18n="settingsTitle">إعدادات النظام وتكوين الرسائل الحقيقية</span>
                </h3>
                <button id="btnCloseSettings" class="opacity-70 hover:opacity-100 transition"><i class="fa-solid fa-xmark text-xl"></i></button>
            </div>

            <!-- Real Messaging Gateway Configuration -->
            <div class="bg-black/25 sub-panel p-3.5 rounded-xl border border-futuristic-accent/30 space-y-2.5">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-extrabold text-futuristic-accent flex items-center gap-1.5">
                        <i class="fa-solid fa-tower-broadcast"></i> <span data-i18n="realMsgConfig">إعداد الإرسال الحقيقي عبر الإنترنت (Real Push / API)</span>
                    </span>
                    <span id="badgeApiStatus" class="text-[10px] px-2 py-0.5 rounded-full bg-slate-700 text-slate-300 font-mono">Local Mode</span>
                </div>

                <!-- Provider Select -->
                <div>
                    <label class="text-[11px] font-bold block mb-1" data-i18n="msgProviderLabel">قناة الإرسال الخلفية التلقائية:</label>
                    <select id="selectMsgProvider" class="w-full bg-slate-900 text-white border border-white/10 rounded-lg p-2 text-xs outline-none focus:border-futuristic-accent">
                        <option value="ntfy">ntfy.sh (إشعار هاتف فوري مجاني بدون حساب)</option>
                        <option value="telegram">Telegram Bot API (رسالة تيليجرام حقيقية)</option>
                        <option value="webhook">Custom / Discord Webhook URL</option>
                        <option value="browser">Browser Notifications Only (إشعار المتصفح فقط)</option>
                    </select>
                </div>

                <!-- ntfy fields -->
                <div id="cfgNtfy" class="space-y-1">
                    <label class="text-[11px] opacity-80 block">ntfy.sh Topic Name (اشترك بنفس الاسم في تطبيق ntfy على هاتفك):</label>
                    <input type="text" id="inputNtfyTopic" placeholder="e.g. gas-rescue-alert-2026" dir="ltr" class="w-full bg-slate-900 text-white border border-white/10 rounded-lg p-2 text-xs font-mono outline-none focus:border-futuristic-accent">
                </div>

                <!-- Telegram fields -->
                <div id="cfgTelegram" class="hidden space-y-2">
                    <div>
                        <label class="text-[11px] opacity-80 block">Telegram Bot Token (from @BotFather):</label>
                        <input type="password" id="inputTgToken" placeholder="123456:ABC-DEF..." dir="ltr" class="w-full bg-slate-900 text-white border border-white/10 rounded-lg p-2 text-xs font-mono outline-none focus:border-futuristic-accent">
                    </div>
                    <div>
                        <label class="text-[11px] opacity-80 block">Telegram Chat ID (from @userinfobot):</label>
                        <input type="text" id="inputTgChatId" placeholder="e.g. 987654321" dir="ltr" class="w-full bg-slate-900 text-white border border-white/10 rounded-lg p-2 text-xs font-mono outline-none focus:border-futuristic-accent">
                    </div>
                </div>

                <!-- Webhook fields -->
                <div id="cfgWebhook" class="hidden space-y-1">
                    <label class="text-[11px] opacity-80 block">Webhook URL (Discord / Make / Zapier / Custom):</label>
                    <input type="url" id="inputWebhookUrl" placeholder="https://discord.com/api/webhooks/..." dir="ltr" class="w-full bg-slate-900 text-white border border-white/10 rounded-lg p-2 text-xs font-mono outline-none focus:border-futuristic-accent">
                </div>

                <div class="flex gap-2 pt-1">
                    <button id="btnTestRealMsg" class="flex-1 py-1.5 rounded-lg bg-futuristic-cyan/20 border border-futuristic-cyan/50 text-futuristic-cyan font-bold text-xs hover:bg-futuristic-cyan/30 transition">
                        <i class="fa-solid fa-paper-plane"></i> <span data-i18n="btnTestSend">تجربة إرسال رسالة حقيقية الآن</span>
                    </button>
                    <button id="btnRequestBrowserNotif" class="px-3 py-1.5 rounded-lg bg-white/10 border border-white/10 text-xs font-bold hover:bg-white/20 transition" title="تفعيل إشعارات المتصفح">
                        <i class="fa-solid fa-bell"></i>
                    </button>
                </div>
            </div>

            <!-- Theme Toggle -->
            <div class="flex justify-between items-center bg-black/20 sub-panel p-3 rounded-xl border border-white/10">
                <span class="text-xs font-bold" data-i18n="themeLabel">مظهر الثيم (Dark / Light Mode):</span>
                <button id="btnToggleTheme" class="px-3 py-1.5 rounded-lg bg-futuristic-accent text-slate-950 font-bold text-xs shadow hover:bg-emerald-300 transition">تغيير للوضع الفاتح</button>
            </div>

            <!-- Language Switcher -->
            <div class="flex flex-col gap-1.5 bg-black/20 sub-panel p-3 rounded-xl border border-white/10">
                <label class="text-xs font-bold" data-i18n="langLabel">لغة الواجهة (Interface Language):</label>
                <select id="selectLang" class="bg-slate-900 text-white border border-white/10 rounded-lg p-2 text-xs outline-none focus:border-futuristic-accent">
                    <option value="ar">العربية (Arabic)</option>
                    <option value="en">English (الإنجليزية)</option>
                </select>
            </div>

            <!-- Interactive Rating -->
            <div class="flex flex-col gap-1.5 bg-black/20 sub-panel p-3 rounded-xl border border-white/10">
                <div class="flex justify-between items-center">
                    <label class="text-xs font-bold" data-i18n="rateLabel">تقييم النظام:</label>
                    <div id="starRatingBox" class="flex gap-1 text-slate-500 cursor-pointer text-sm">
                        <i class="fa-solid fa-star hover:text-futuristic-warning transition" data-star="1"></i>
                        <i class="fa-solid fa-star hover:text-futuristic-warning transition" data-star="2"></i>
                        <i class="fa-solid fa-star hover:text-futuristic-warning transition" data-star="3"></i>
                        <i class="fa-solid fa-star hover:text-futuristic-warning transition" data-star="4"></i>
                        <i class="fa-solid fa-star hover:text-futuristic-warning transition" data-star="5"></i>
                    </div>
                </div>
            </div>

            <button id="btnSaveSettings" class="w-full py-2.5 rounded-xl bg-gradient-to-r from-futuristic-accent to-futuristic-cyan text-slate-950 font-bold text-xs shadow-lg hover:opacity-90 transition" data-i18n="btnSaveClose">حفظ الإعدادات وإغلاق</button>
        </div>
    </div>

    <!-- SCREEN 1: DEVICE REAL-TIME SIMULATOR -->
    <main id="screen1" class="flex flex-col gap-5 w-full">

        <!-- Top Metrics Row -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">

            <!-- MQ-2 Gas Reading -->
            <div id="cardGas" class="glass-card p-4 flex flex-col justify-between transition-all duration-300">
                <div class="flex justify-between items-center">
                    <span class="text-xs font-bold opacity-75 flex items-center gap-1.5">
                        <i class="fa-solid fa-wind text-futuristic-accent"></i> <span data-i18n="metricGas">تركيز الغاز MQ-2</span>
                    </span>
                    <span id="badgeGas" class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 font-bold">آمن</span>
                </div>
                <div class="my-2">
                    <div class="text-3xl font-black font-mono" id="valGasDisplay">
                        120 <span class="text-xs font-normal opacity-75">PPM</span>
                    </div>
                </div>
                <div class="w-full bg-black/40 rounded-full h-2 overflow-hidden border border-white/10">
                    <div id="barGas" class="bg-gradient-to-r from-emerald-400 via-yellow-400 to-red-500 h-full w-[15%] transition-all duration-300"></div>
                </div>
            </div>

            <!-- Current Intensity (A) -->
            <div class="glass-card p-4 flex flex-col justify-between">
                <div class="flex justify-between items-center">
                    <span class="text-xs font-bold opacity-75 flex items-center gap-1.5">
                        <i class="fa-solid fa-bolt text-futuristic-warning"></i> <span data-i18n="metricCurrent">شدة التيار الكهربائي</span>
                    </span>
                    <span class="text-[10px] text-futuristic-warning font-mono">Arduino Uno A0</span>
                </div>
                <div class="my-2 text-center">
                    <span id="valCurrentDisplay" class="text-3xl font-black font-mono text-futuristic-warning">5.0</span>
                    <span class="text-xs opacity-75" data-i18n="unitAmp">أمبير (A)</span>
                </div>
                <div id="textCurrentImpact" class="text-[10px] text-center text-emerald-400 bg-emerald-500/10 py-1 rounded-lg border border-emerald-500/20 font-bold">
                    معالجة إيجابية وسريعة للحساس
                </div>
            </div>

            <!-- System Response Time -->
            <div class="glass-card p-4 flex flex-col justify-between">
                <div class="flex justify-between items-center">
                    <span class="text-xs font-bold opacity-75 flex items-center gap-1.5">
                        <i class="fa-solid fa-stopwatch text-futuristic-cyan"></i> <span data-i18n="metricResponse">سرعة استجابة الإنقاذ</span>
                    </span>
                    <span class="text-[10px] text-futuristic-cyan font-mono">Real-time</span>
                </div>
                <div class="my-2 text-center">
                    <span id="valResponseTime" class="text-3xl font-black font-mono text-futuristic-cyan">&lt; 1.60</span>
                    <span class="text-xs opacity-75" data-i18n="unitSec">ثانية</span>
                </div>
                <div class="text-[10px] text-center text-futuristic-cyan bg-futuristic-cyan/10 py-1 rounded-lg border border-futuristic-cyan/20 font-bold" data-i18n="autoRespBadge">
                    استجابة فورية آلياً
                </div>
            </div>

            <!-- Cloud / GSM Status -->
            <div class="glass-card p-4 flex flex-col justify-between">
                <div class="flex justify-between items-center">
                    <span class="text-xs font-bold opacity-75 flex items-center gap-1.5">
                        <i class="fa-solid fa-signal text-futuristic-accent"></i> <span data-i18n="metricGsm">الاتصال والـ GSM</span>
                    </span>
                    <span id="badgeGsmSignal" class="text-[10px] text-emerald-400 font-mono">SIM800L Online</span>
                </div>
                <div class="my-2 text-center">
                    <span class="text-xl font-bold flex items-center justify-center gap-2">
                        <i class="fa-solid fa-tower-cell text-futuristic-accent animate-pulse"></i> <span data-i18n="emergencyNet">شبكة الطوارئ</span>
                    </span>
                </div>
                <div class="text-[10px] text-center opacity-75 bg-white/5 sub-panel py-1 rounded-lg border border-white/10 font-mono" id="txtActiveChannel">
                    Real SMS / Push Ready
                </div>
            </div>

        </div>

        <!-- Middle Section: Controls & Actuators -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">

            <!-- Actuators Panel (7 Cols) -->
            <div class="lg:col-span-7 glass-card p-5 flex flex-col gap-4">
                <div class="flex justify-between items-center border-b border-white/10 pb-3">
                    <h2 class="text-sm font-extrabold flex items-center gap-2">
                        <i class="fa-solid fa-sliders text-futuristic-accent"></i> <span data-i18n="actuatorsTitle">الأجهزة التنفيذية والمرحّلات (اضغط للتحكم اليدوي)</span>
                    </h2>
                    <span class="text-xs opacity-75" data-i18n="actuatorsSub">التحكم الآلي والمباشر</span>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                    <!-- Exhaust Fan (Clickable) -->
                    <button id="cardFan" type="button" class="text-start bg-black/20 sub-panel border border-white/10 rounded-2xl p-3 flex flex-col justify-between gap-2 transition-all hover:scale-[1.02] cursor-pointer">
                        <div class="flex justify-between items-start w-full">
                            <span class="text-xs font-bold" data-i18n="actFan">شفاط الغاز</span>
                            <i id="iconFan" class="fa-solid fa-fan text-slate-500 text-xl"></i>
                        </div>
                        <div>
                            <span id="txtFanStatus" class="text-[11px] opacity-75 block font-semibold">متوقف</span>
                            <span id="badgeFanRelay" class="text-[9px] font-mono px-2 py-0.5 rounded bg-black/40 text-slate-400">Relay #1 OFF</span>
                        </div>
                    </button>

                    <!-- Main Power Cut Relay (Clickable) -->
                    <button id="cardPower" type="button" class="text-start bg-black/20 sub-panel border border-white/10 rounded-2xl p-3 flex flex-col justify-between gap-2 transition-all hover:scale-[1.02] cursor-pointer">
                        <div class="flex justify-between items-start w-full">
                            <span class="text-xs font-bold" data-i18n="actPower">التيار الكهربائي</span>
                            <i id="iconPower" class="fa-solid fa-plug-circle-check text-emerald-400 text-xl"></i>
                        </div>
                        <div>
                            <span id="txtPowerStatus" class="text-[11px] text-emerald-400 block font-bold">متصل (آمن)</span>
                            <span id="badgePowerRelay" class="text-[9px] font-mono px-2 py-0.5 rounded bg-black/40 text-emerald-400">Relay #2 ON</span>
                        </div>
                    </button>

                    <!-- Piezo Alarm Buzzer (Clickable) -->
                    <button id="cardBuzzer" type="button" class="text-start bg-black/20 sub-panel border border-white/10 rounded-2xl p-3 flex flex-col justify-between gap-2 transition-all hover:scale-[1.02] cursor-pointer">
                        <div class="flex justify-between items-start w-full">
                            <span class="text-xs font-bold" data-i18n="actBuzzer">صفارة الإنذار</span>
                            <i id="iconBuzzer" class="fa-solid fa-volume-xmark text-slate-500 text-xl"></i>
                        </div>
                        <div>
                            <span id="txtBuzzerStatus" class="text-[11px] opacity-75 block font-semibold">صامت</span>
                            <span id="badgeBuzzerPin" class="text-[9px] font-mono px-2 py-0.5 rounded bg-black/40 text-slate-400">Pin D8 Sound</span>
                        </div>
                    </button>

                    <!-- GSM Alert (Clickable to Trigger Real SMS) -->
                    <button id="cardSMSAlert" type="button" class="text-start bg-black/20 sub-panel border border-white/10 rounded-2xl p-3 flex flex-col justify-between gap-2 transition-all hover:scale-[1.02] cursor-pointer">
                        <div class="flex justify-between items-start w-full">
                            <span class="text-xs font-bold" data-i18n="actSms">تنبيه الـ SMS</span>
                            <i id="iconSMSAlert" class="fa-solid fa-comment-sms text-slate-500 text-xl"></i>
                        </div>
                        <div>
                            <span id="txtSMSStatus" class="text-[11px] opacity-75 block font-semibold">جاهز</span>
                            <span id="badgeSmsTrigger" class="text-[9px] font-mono px-2 py-0.5 rounded bg-black/40 text-slate-400">SIM800L Trigger</span>
                        </div>
                    </button>
                </div>

                <!-- Live Chart -->
                <div class="mt-2 flex flex-col gap-2">
                    <div class="flex justify-between items-center">
                        <span class="text-xs font-bold opacity-75 flex items-center gap-2">
                            <i class="fa-solid fa-chart-line text-futuristic-cyan"></i> <span data-i18n="chartTitle">التغير اللحظي لنسبة الغاز (PPM Live Graph)</span>
                        </span>
                        <label class="flex items-center gap-1.5 text-[11px] font-bold cursor-pointer">
                            <input type="checkbox" id="chkContinuousLeak" class="accent-futuristic-danger">
                            <span data-i18n="chkLeak">استمرار التسرب (منع الشفاط من خفض الغاز)</span>
                        </label>
                    </div>
                    <div class="h-44 w-full relative">
                        <canvas id="liveGasChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Experiment Controls & Simulator Sliders (5 Cols) -->
            <div class="lg:col-span-5 glass-card p-5 flex flex-col justify-between gap-4">
                <div class="space-y-3">
                    <div class="flex justify-between items-center border-b border-white/10 pb-3">
                        <h2 class="text-sm font-extrabold text-futuristic-warning flex items-center gap-2">
