        function updateChartTheme() {
            if (!chartInstance) return;
            const tickColor = state.isDarkMode ? '#94A3B8' : '#334155';
            const gridColor = state.isDarkMode ? 'rgba(255,255,255,0.06)' : 'rgba(15,23,42,0.08)';
            chartInstance.options.scales.x.grid.color = gridColor;
            chartInstance.options.scales.y.grid.color = gridColor;
            chartInstance.options.scales.x.ticks.color = tickColor;
            chartInstance.options.scales.y.ticks.color = tickColor;
            chartInstance.update();
        }

        function pushChartData(val) {
            if (!chartInstance) return;
            const data = chartInstance.data.datasets[0].data;
            const labels = chartInstance.data.labels;
            const timeLabel = new Date().toTimeString().split(' ')[0];
            data.shift();
            data.push(val);
            labels.shift();
            labels.push(timeLabel);
            chartInstance.data.datasets[0].borderColor = val > 350 ? '#FF0054' : '#00F5D4';
            chartInstance.data.datasets[0].backgroundColor = val > 350 ? 'rgba(255, 0, 84, 0.14)' : 'rgba(0, 245, 212, 0.1)';
            chartInstance.update();
        }

        // Realistic physics & live sensor tick every 2 seconds
        setInterval(() => {
            const fanActive = state.isEmergency || state.isFanOverride;
            const continuousLeak = document.getElementById('chkContinuousLeak').checked;

            if (fanActive && !continuousLeak && state.gasPPM > 110) {
                // Fan vents gas faster when current intensity is higher
                const ventRate = Math.round(18 + state.amperes * 3.5);
                const nextPPM = Math.max(105, state.gasPPM - ventRate);
                updateGasState(nextPPM, true);
            } else {
                // Subtle realistic MQ-2 sensor fluctuation
                const jitter = Math.floor(Math.random() * 7) - 3;
                const nextPPM = Math.max(80, Math.min(950, state.gasPPM + jitter));
                if (state.gasPPM <= 350 || continuousLeak) {
                    pushChartData(nextPPM);
                }
            }
        }, 2000);

        // =========================
        // 10. WEB SERIAL API (OPTIONAL REAL ARDUINO USB)
        // =========================
        document.getElementById('btnArduinoSerial').addEventListener('click', async () => {
            if (!('serial' in navigator)) {
                showToast(state.lang === 'ar'
                    ? 'متصفحك لا يدعم Web Serial. استخدم Chrome/Edge على الكمبيوتر.'
                    : 'Web Serial is not supported in this browser. Use Chrome/Edge on desktop.', 'warning');
                return;
            }
            try {
                const port = await navigator.serial.requestPort();
                await port.open({ baudRate: 9600 });
                logSystemMessage('Real Arduino USB Serial Connected (9600 baud)!', 'accent');
                showToast('Arduino USB Connected!', 'success');

                const decoder = new TextDecoderStream();
                port.readable.pipeTo(decoder.writable);
                const reader = decoder.readable.getReader();
                let buffer = '';
                while (true) {
                    const { value, done } = await reader.read();
                    if (done) break;
                    buffer += value;
                    const lines = buffer.split('\n');
                    buffer = lines.pop();
                    for (const line of lines) {
                        const match = line.match(/\d+/);
                        if (match) {
                            const ppm = parseInt(match[0], 10);
                            if (ppm >= 0 && ppm <= 1500) {
                                updateGasState(ppm, true);
                            }
                        }
                    }
                }
            } catch (err) {
                logSystemMessage(`Serial info: ${err.message}`, 'warning');
            }
        });

